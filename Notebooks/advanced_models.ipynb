# FINANCIAL NEWS SENTIMENT ANALYSIS
# Week 5: Train Advanced Models (XGBoost, BERT) + Feature Importance & Error Analysis
# Author: Mishti Gala

import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns
import warnings
warnings.filterwarnings("ignore")

from sklearn.model_selection import GridSearchCV, cross_val_score
from sklearn.metrics import accuracy_score, precision_score, recall_score, f1_score, roc_auc_score
from sklearn.metrics import mean_squared_error, mean_absolute_error, r2_score, confusion_matrix, roc_curve
from sklearn.decomposition import PCA
import xgboost as xgb

# Try to import BERT dependencies
try:
    from transformers import AutoTokenizer, AutoModel
    import torch
    bert_available = True
    print("BERT dependencies available")
except ImportError:
    bert_available = False
    print("BERT dependencies not available - continuing without BERT embeddings")

RANDOM_STATE = 42
np.random.seed(RANDOM_STATE)

print("Loading stock and sentiment data...")
stocks = ['AAPL', 'TSLA', 'AMZN', 'MSFT']
all_data = []

for stock in stocks:
    try:
        df = pd.read_csv(f"Data/{stock}_merged.csv")
        df['stock'] = stock
        df['date'] = pd.to_datetime(df['date'])
        all_data.append(df)
        print(f"Loaded {stock}: {len(df)} records")
    except FileNotFoundError:
        print(f"Warning: {stock}_merged.csv not found")
        continue
    except Exception as e:
        print(f"Error loading {stock}: {e}")
        continue

if not all_data:
    raise ValueError("No data files could be loaded. Check your file paths.")

data = pd.concat(all_data, ignore_index=True).sort_values('date').reset_index(drop=True)
print(f"Total combined data: {len(data)} records")

print("Creating features...")
# Target variables
data['movement_pct'] = ((data['close'] - data['open']) / data['open']) * 100
data['price_direction'] = (data['movement_pct'] > 0).astype(int)

# Technical features
data['price_volatility'] = data.groupby('stock')['movement_pct'].rolling(5, min_periods=1).std().reset_index(drop=True).fillna(0)
data['momentum'] = data.groupby('stock')['movement_pct'].rolling(3, min_periods=1).mean().reset_index(drop=True).fillna(0)
data['volume_ma'] = data.groupby('stock')['volume'].rolling(5, min_periods=1).mean().reset_index(drop=True)
data['high_low_spread'] = data['high'] - data['low']
data['open_close_ratio'] = data['close'] / data['open']

# Time-based features
data['day_of_week'] = data['date'].dt.dayofweek
data['month'] = data['date'].dt.month
data['is_month_end'] = data['date'].dt.is_month_end.astype(int)

# Enhanced sentiment features
if 'vader_compound' in data.columns:
    data['vader_rolling'] = data.groupby('stock')['vader_compound'].rolling(3, min_periods=1).mean().reset_index(drop=True).fillna(0)
    data['vader_volatility'] = data.groupby('stock')['vader_compound'].rolling(3, min_periods=1).std().reset_index(drop=True).fillna(0)
    data['vader_positive'] = (data['vader_compound'] > 0).astype(int)
    data['vader_negative'] = (data['vader_compound'] < 0).astype(int)

if 'bert_score_scaled' in data.columns:
    data['bert_rolling'] = data.groupby('stock')['bert_score_scaled'].rolling(3, min_periods=1).mean().reset_index(drop=True).fillna(0)
    data['bert_volatility'] = data.groupby('stock')['bert_score_scaled'].rolling(3, min_periods=1).std().reset_index(drop=True).fillna(0)

# Sentiment features from existing label_num
if 'label_num' in data.columns:
    data['sentiment_strength'] = abs(data['label_num'])
    data['sentiment_positive'] = (data['label_num'] > 0).astype(int)
    data['sentiment_negative'] = (data['label_num'] < 0).astype(int)

# Stock dummy variables
stock_dummies = pd.get_dummies(data['stock'], prefix='stock')
data = pd.concat([data, stock_dummies], axis=1)

# BERT embeddings processing
if bert_available and 'headline' in data.columns:
    print("Generating BERT embeddings...")
    
    try:
        tokenizer = AutoTokenizer.from_pretrained('bert-base-uncased')
        model = AutoModel.from_pretrained('bert-base-uncased')
        model.eval()
        
        device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
        model.to(device)
        print(f"Using device: {device}")
        
        def get_bert_cls_embeddings(texts, batch_size=16):
            embeddings = []
            texts = list(texts)
            
            for i in range(0, len(texts), batch_size):
                batch = texts[i:i+batch_size]
                try:
                    with torch.no_grad():
                        tokens = tokenizer(
                            batch, 
                            return_tensors='pt', 
                            padding=True, 
                            truncation=True, 
                            max_length=128
                        ).to(device)
                        outputs = model(**tokens)
                        cls_embeddings = outputs.last_hidden_state[:, 0, :].cpu().numpy()
                        embeddings.extend(cls_embeddings)
                        
                    if (i // batch_size + 1) % 10 == 0:
                        print(f"Processed {min(i + batch_size, len(texts))}/{len(texts)} headlines")
                        
                except Exception as e:
                    print(f"Error processing batch {i}: {e}")
                    # Add zero embeddings for failed batch
                    for _ in range(len(batch)):
                        embeddings.append(np.zeros(768))
            
            return np.array(embeddings)
        
        # Get unique headlines to avoid duplicate processing
        unique_headlines = data['headline'].fillna('').unique()
        print(f"Processing {len(unique_headlines)} unique headlines...")
        
        unique_embeddings = get_bert_cls_embeddings(unique_headlines)
        
        # Create mapping from headline to embedding
        headline_to_embedding = dict(zip(unique_headlines, unique_embeddings))
        
        # Map embeddings back to full dataset
        headline_embeddings = []
        for headline in data['headline'].fillna(''):
            if headline in headline_to_embedding:
                headline_embeddings.append(headline_to_embedding[headline])
            else:
                headline_embeddings.append(np.zeros(768))
        
        bert_matrix = np.array(headline_embeddings)
        
        # Apply PCA for dimensionality reduction
        print("Applying PCA to BERT embeddings...")
        pca = PCA(n_components=50, random_state=RANDOM_STATE)
        bert_pca = pca.fit_transform(bert_matrix)
        
        # Add PCA components as features
        for i in range(bert_pca.shape[1]):
            data[f'bert_pca_{i}'] = bert_pca[:, i]
        
        print(f"Added {bert_pca.shape[1]} BERT PCA features")
        print(f"PCA explained variance ratio: {pca.explained_variance_ratio_.sum():.3f}")
        
    except Exception as e:
        print(f"Error in BERT processing: {e}")
        print("Continuing without BERT embeddings...")

print("Preparing modeling data...")
# Define features to exclude
exclude_columns = [
    'headline', 'headline_clean', 'date', 'movement', 'stock', 
    'price_direction', 'movement_pct', 'Unnamed: 0'
]

# Select numeric features
all_columns = set(data.columns)
exclude_set = set(exclude_columns)
potential_features = all_columns - exclude_set

# Filter for numeric columns only
numeric_features = []
for col in potential_features:
    if col in data.columns and data[col].dtype in ['int64', 'float64', 'int32', 'float32']:
        numeric_features.append(col)

print(f"Selected {len(numeric_features)} numeric features")

# Prepare feature matrix
X = data[numeric_features].fillna(0)
X = X.replace([np.inf, -np.inf], 0)

# Prepare targets
y_class = data['price_direction']
y_reg = data['movement_pct'].fillna(0)

# Time-based train/test split
split_date = data['date'].quantile(0.8)
train_mask = data['date'] < split_date

X_train, X_test = X[train_mask], X[~train_mask]
yc_train, yc_test = y_class[train_mask], y_class[~train_mask]
yr_train, yr_test = y_reg[train_mask], y_reg[~train_mask]

print(f"Training set: {len(X_train)} samples")
print(f"Test set: {len(X_test)} samples")
print(f"Class distribution in training: {yc_train.value_counts().to_dict()}")

print("Training XGBoost Classifier with hyperparameter tuning...")
# Classification model with hyperparameter tuning
param_grid_clf = {
    'max_depth': [3, 5, 7],
    'learning_rate': [0.05, 0.1, 0.2],
    'n_estimators': [100, 200],
    'subsample': [0.8, 1.0],
    'colsample_bytree': [0.8, 1.0]
}

base_clf = xgb.XGBClassifier(
    random_state=RANDOM_STATE,
    use_label_encoder=False,
    eval_metric='logloss'
)

grid_search_clf = GridSearchCV(
    base_clf,
    param_grid_clf,
    cv=3,
    scoring='f1',
    n_jobs=-1,
    verbose=0
)

grid_search_clf.fit(X_train, yc_train)
print(f"Best classifier parameters: {grid_search_clf.best_params_}")
print(f"Best CV F1 score: {grid_search_clf.best_score_:.3f}")

# Predictions for classification
yp_class = grid_search_clf.predict(X_test)
yp_proba = grid_search_clf.predict_proba(X_test)[:, 1]

print("Training XGBoost Regressor with hyperparameter tuning...")
# Regression model with hyperparameter tuning
param_grid_reg = {
    'max_depth': [3, 5, 7],
    'learning_rate': [0.05, 0.1, 0.2],
    'n_estimators': [100, 200],
    'subsample': [0.8, 1.0],
    'colsample_bytree': [0.8, 1.0]
}

base_reg = xgb.XGBRegressor(random_state=RANDOM_STATE)

grid_search_reg = GridSearchCV(
    base_reg,
    param_grid_reg,
    cv=3,
    scoring='r2',
    n_jobs=-1,
    verbose=0
)

grid_search_reg.fit(X_train, yr_train)
print(f"Best regressor parameters: {grid_search_reg.best_params_}")
print(f"Best CV R2 score: {grid_search_reg.best_score_:.3f}")

# Predictions for regression
yp_reg = grid_search_reg.predict(X_test)

print("Analyzing feature importance...")
# Feature importance analysis
clf_importance = grid_search_clf.best_estimator_.feature_importances_
reg_importance = grid_search_reg.best_estimator_.feature_importances_

importance_df = pd.DataFrame({
    'feature': numeric_features,
    'importance_classification': clf_importance,
    'importance_regression': reg_importance,
    'importance_average': (clf_importance + reg_importance) / 2
})

importance_df = importance_df.sort_values('importance_average', ascending=False)

print("Top 15 Most Important Features:")
print("=" * 60)
for i, row in importance_df.head(15).iterrows():
    print(f"{row['feature'][:35]:<35} {row['importance_average']:.4f}")

# Categorize features
bert_features = [f for f in numeric_features if 'bert_pca_' in f]
sentiment_features = [f for f in numeric_features if any(word in f.lower() for word in ['vader', 'bert_score', 'sentiment', 'label'])]
technical_features = [f for f in numeric_features if any(word in f.lower() for word in ['volatility', 'momentum', 'volume', 'spread', 'ratio'])]
stock_features = [f for f in numeric_features if 'stock_' in f]
time_features = [f for f in numeric_features if any(word in f.lower() for word in ['day', 'month', 'week'])]

print(f"\nFeature Categories:")
print(f"BERT features: {len(bert_features)}")
print(f"Sentiment features: {len(sentiment_features)}")
print(f"Technical features: {len(technical_features)}")
print(f"Stock features: {len(stock_features)}")
print(f"Time features: {len(time_features)}")

# Visualization: Feature Importance
plt.figure(figsize=(12, 8))
top_20 = importance_df.head(20)
sns.barplot(data=top_20, x='importance_average', y='feature')
plt.title('Top 20 Most Important Features (Average Importance)')
plt.xlabel('Average Importance Score')
plt.tight_layout()
plt.show()

# Visualization: Feature Importance by Category
if bert_features:
    category_importance = {
        'BERT': importance_df[importance_df['feature'].isin(bert_features)]['importance_average'].mean(),
        'Sentiment': importance_df[importance_df['feature'].isin(sentiment_features)]['importance_average'].mean(),
        'Technical': importance_df[importance_df['feature'].isin(technical_features)]['importance_average'].mean(),
        'Stock': importance_df[importance_df['feature'].isin(stock_features)]['importance_average'].mean(),
        'Time': importance_df[importance_df['feature'].isin(time_features)]['importance_average'].mean()
    }
    
    plt.figure(figsize=(10, 6))
    categories = list(category_importance.keys())
    values = list(category_importance.values())
    sns.barplot(x=categories, y=values)
    plt.title('Average Feature Importance by Category')
    plt.ylabel('Average Importance Score')
    plt.xticks(rotation=45)
    plt.tight_layout()
    plt.show()

print("Performing error analysis...")
# Classification metrics
clf_accuracy = accuracy_score(yc_test, yp_class)
clf_precision = precision_score(yc_test, yp_class)
clf_recall = recall_score(yc_test, yp_class)
clf_f1 = f1_score(yc_test, yp_class)
clf_auc = roc_auc_score(yc_test, yp_proba)

# Regression metrics
reg_r2 = r2_score(yr_test, yp_reg)
reg_rmse = np.sqrt(mean_squared_error(yr_test, yp_reg))
reg_mae = mean_absolute_error(yr_test, yp_reg)

# Directional accuracy for regression
actual_direction = (yr_test > 0).astype(int)
pred_direction = (yp_reg > 0).astype(int)
directional_accuracy = accuracy_score(actual_direction, pred_direction)

print("\nMODEL PERFORMANCE RESULTS")
print("=" * 50)
print("Classification Model:")
print(f"  Accuracy:  {clf_accuracy:.3f}")
print(f"  Precision: {clf_precision:.3f}")
print(f"  Recall:    {clf_recall:.3f}")
print(f"  F1 Score:  {clf_f1:.3f}")
print(f"  ROC AUC:   {clf_auc:.3f}")

print(f"\nRegression Model:")
print(f"  R-squared: {reg_r2:.3f}")
print(f"  RMSE:      {reg_rmse:.3f}")
print(f"  MAE:       {reg_mae:.3f}")
print(f"  Directional Accuracy: {directional_accuracy:.3f}")

# Cross-validation scores
print(f"\nCross-Validation Scores:")
cv_scores_clf = cross_val_score(grid_search_clf.best_estimator_, X_train, yc_train, cv=5, scoring='f1')
cv_scores_reg = cross_val_score(grid_search_reg.best_estimator_, X_train, yr_train, cv=5, scoring='r2')

print(f"Classification CV F1: {cv_scores_clf.mean():.3f} (+/- {cv_scores_clf.std()*2:.3f})")
print(f"Regression CV R2: {cv_scores_reg.mean():.3f} (+/- {cv_scores_reg.std()*2:.3f})")

# Visualization: Confusion Matrix
plt.figure(figsize=(8, 6))
cm = confusion_matrix(yc_test, yp_class)
sns.heatmap(cm, annot=True, fmt='d', cmap='Blues', 
            xticklabels=['Down', 'Up'], yticklabels=['Down', 'Up'])
plt.title('Confusion Matrix - XGBoost Classification')
plt.xlabel('Predicted Direction')
plt.ylabel('Actual Direction')
plt.show()

# Visualization: ROC Curve
plt.figure(figsize=(8, 6))
fpr, tpr, _ = roc_curve(yc_test, yp_proba)
plt.plot(fpr, tpr, linewidth=2, label=f'XGBoost (AUC = {clf_auc:.3f})')
plt.plot([0, 1], [0, 1], 'k--', alpha=0.5, label='Random Classifier')
plt.xlabel('False Positive Rate')
plt.ylabel('True Positive Rate')
plt.title('ROC Curve - XGBoost Classification')
plt.legend()
plt.grid(True, alpha=0.3)
plt.show()

# Visualization: Regression Performance
plt.figure(figsize=(12, 5))

# Predicted vs Actual
plt.subplot(1, 2, 1)
plt.scatter(yr_test, yp_reg, alpha=0.6, s=20)
plt.plot([yr_test.min(), yr_test.max()], [yr_test.min(), yr_test.max()], 'r--', lw=2)
plt.xlabel('Actual Movement %')
plt.ylabel('Predicted Movement %')
plt.title(f'Predicted vs Actual (R² = {reg_r2:.3f})')
plt.grid(True, alpha=0.3)

# Residuals
plt.subplot(1, 2, 2)
residuals = yr_test - yp_reg
plt.scatter(yp_reg, residuals, alpha=0.6, s=20)
plt.axhline(y=0, color='r', linestyle='--')
plt.xlabel('Predicted Movement %')
plt.ylabel('Residuals')
plt.title('Residuals Plot')
plt.grid(True, alpha=0.3)

plt.tight_layout()
plt.show()

# Visualization: Directional Accuracy
plt.figure(figsize=(6, 5))
direction_cm = confusion_matrix(actual_direction, pred_direction)
sns.heatmap(direction_cm, annot=True, fmt='d', cmap='Greens',
            xticklabels=['Down', 'Up'], yticklabels=['Down', 'Up'])
plt.title(f'Directional Accuracy: {directional_accuracy:.3f}')
plt.xlabel('Predicted Direction')
plt.ylabel('Actual Direction')
plt.show()

# Save results for further analysis
results = {
    'classification_metrics': {
        'accuracy': clf_accuracy,
        'precision': clf_precision,
        'recall': clf_recall,
        'f1': clf_f1,
        'auc': clf_auc
    },
    'regression_metrics': {
        'r2': reg_r2,
        'rmse': reg_rmse,
        'mae': reg_mae,
        'directional_accuracy': directional_accuracy
    },
    'feature_importance': importance_df,
    'best_clf_params': grid_search_clf.best_params_,
    'best_reg_params': grid_search_reg.best_params_
}

print(f"\nResults saved in 'results' dictionary for further analysis")
