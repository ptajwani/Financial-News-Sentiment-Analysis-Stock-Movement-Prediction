## 6. MAIN EXECUTION PIPELINE

def run_advanced_modeling_pipeline():
    """Run the complete advanced modeling pipeline"""
    print("🚀 STARTING ADVANCED MODELING PIPELINE")
    print("=" * 60)
    
    try:
        # Step 1: Setup BERT (optional)
        tokenizer, model, device, bert_available = setup_bert_embeddings()
        
        # Step 2: Load data
        stock_data, sentiment_df = load_project_data()
        
        # Step 3: Create comprehensive features
        final_df = create_comprehensive_features(
            stock_data, sentiment_df, bert_available, tokenizer, model, device
        )
        
        # Step 4: Initialize and train XGBoost models
        xgb_models = AdvancedXGBoostModels(random_state=RANDOM_STATE)
        X, y_classification, y_regression = xgb_models.prepare_modeling_data(final_df)
        model_results = xgb_models.train_and_evaluate(X, y_classification, y_regression)
        
        # Step 5: Feature importance analysis
        importance_df, category_importance = analyze_feature_importance(model_results, xgb_models.feature_names)
        
        # Step 6: Error analysis
        error_analysis = perform_comprehensive_error_analysis(model_results, xgb_models.feature_names)
        
        # Step 7: Generate final report
        generate_final_advanced_report(model_results, importance_df, category_importance, error_analysis)
        
        print(f"\n🎉 ADVANCED MODELING PIPELINE COMPLETED SUCCESSFULLY!")
        print("=" * 60)
        
        return {
            'model_results': model_results,
            'feature_importance': importance_df,
            'category_importance': category_importance,
            'error_analysis': error_analysis,
            'feature_names': xgb_models.feature_names,
            'final_data': final_df
        }
        
    except Exception as e:
        print(f"\n❌ PIPELINE ERROR: {str(e)}")
        print("Please check your data files and dependencies.")
        raise e

