# FINANCIAL NEWS SENTIMENT ANALYSIS
# Week 5: Train Advanced Models (XGBoost, BERT) + Feature Importance & Error Analysis
# Author: Mishti Gala

import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns
import warnings
warnings.filterwarnings("ignore")

from sklearn.model_selection import TimeSeriesSplit, GridSearchCV, cross_val_score
from sklearn.metrics import accuracy_score, precision_score, recall_score, f1_score, roc_auc_score
from sklearn.metrics import mean_squared_error, mean_absolute_error, r2_score, confusion_matrix, roc_curve
from sklearn.decomposition import PCA
from sklearn.preprocessing import LabelEncoder
import xgboost as xgb

try:
    from transformers import AutoTokenizer, AutoModel
    import torch
    bert_available = True
except ImportError:
    bert_available = False

RANDOM_STATE = 42
sns.set()

print("\n📂 Loading stock and sentiment data...")
stocks = ['AAPL', 'TSLA', 'AMZN', 'MSFT']
all_data = []

for stock in stocks:
    try:
        df = pd.read_csv(f"Data/{stock}_merged.csv")
        df['stock'] = stock
        df['date'] = pd.to_datetime(df['date'])
        all_data.append(df)
    except FileNotFoundError:
        print(f"Warning: {stock}_merged.csv not found")
        continue

data = pd.concat(all_data).sort_values('date').reset_index(drop=True)

data['movement_pct'] = ((data['close'] - data['open']) / data['open']) * 100
data['price_direction'] = (data['movement_pct'] > 0).astype(int)
data['price_volatility'] = data.groupby('stock')['movement_pct'].rolling(5).std().reset_index(drop=True).fillna(0)
data['momentum'] = data.groupby('stock')['movement_pct'].rolling(3).mean().reset_index(drop=True).fillna(0)
data['day_of_week'] = data['date'].dt.dayofweek
data['month'] = data['date'].dt.month

if 'vader_compound' in data.columns:
    data['vader_rolling'] = data.groupby('stock')['vader_compound'].rolling(3).mean().reset_index(drop=True).fillna(0)
if 'bert_score_scaled' in data.columns:
    data['bert_rolling'] = data.groupby('stock')['bert_score_scaled'].rolling(3).mean().reset_index(drop=True).fillna(0)

if bert_available and 'headline' in data.columns:
    print("\n🤖 Generating BERT embeddings (CLS token)...")
    tokenizer = AutoTokenizer.from_pretrained('bert-base-uncased')
    model = AutoModel.from_pretrained('bert-base-uncased')
    model.eval()

    device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
    model.to(device)

    def get_bert_cls_embeddings(texts):
        embeddings = []
        batch_size = 32
        for i in range(0, len(texts), batch_size):
            batch = texts[i:i+batch_size]
            with torch.no_grad():
                tokens = tokenizer(list(batch), return_tensors='pt', padding=True, truncation=True, max_length=64).to(device)
                outputs = model(**tokens)
                cls_embeddings = outputs.last_hidden_state[:, 0, :].cpu().numpy()
                embeddings.extend(cls_embeddings)
        return np.array(embeddings)

    unique_headlines = data['headline'].fillna('').unique()
    headline_to_emb = dict(zip(unique_headlines, get_bert_cls_embeddings(unique_headlines)))
    data['bert_embedding'] = data['headline'].fillna('').map(headline_to_emb)

    bert_matrix = np.vstack(data['bert_embedding'])
    pca = PCA(n_components=64, random_state=RANDOM_STATE)
    bert_pca = pca.fit_transform(bert_matrix)
    for i in range(bert_pca.shape[1]):
        data[f'bert_pca_{i}'] = bert_pca[:, i]
    data.drop(columns=['bert_embedding'], inplace=True)

print("\n🔧 Preparing features and targets...")
exclude = ['headline', 'headline_clean', 'date', 'movement', 'stock', 'price_direction', 'movement_pct']
features = [c for c in data.columns if c not in exclude and data[c].dtype in [np.float64, np.int64]]
X = data[features].fillna(0)
y_class = data['price_direction']
y_reg = data['movement_pct']

data['split'] = (data['date'] < data['date'].quantile(0.8)).astype(int)
X_train, X_test = X[data['split']==1], X[data['split']==0]
yc_train, yc_test = y_class[data['split']==1], y_class[data['split']==0]
yr_train, yr_test = y_reg[data['split']==1], y_reg[data['split']==0]

print("\n📈 Training XGBoost Classifier...")
param_grid = {
    'max_depth': [3, 5],
    'learning_rate': [0.05, 0.1],
    'n_estimators': [100, 200],
    'subsample': [0.8],
    'colsample_bytree': [0.8]
}
clf_base = xgb.XGBClassifier(random_state=RANDOM_STATE, use_label_encoder=False, eval_metric='logloss')
gs_clf = GridSearchCV(clf_base, param_grid, cv=3, scoring='f1', n_jobs=-1)
gs_clf.fit(X_train, yc_train)
yp_class = gs_clf.predict(X_test)
yp_proba = gs_clf.predict_proba(X_test)[:,1]

print("\n📉 Training XGBoost Regressor...")
reg_base = xgb.XGBRegressor(random_state=RANDOM_STATE)
gs_reg = GridSearchCV(reg_base, param_grid, cv=3, scoring='r2', n_jobs=-1)
gs_reg.fit(X_train, yr_train)
yp_reg = gs_reg.predict(X_test)

print("\n🔍 Feature Importance Analysis")
importances = pd.DataFrame({
    'feature': features,
    'importance_cls': gs_clf.best_estimator_.feature_importances_,
    'importance_reg': gs_reg.best_estimator_.feature_importances_
})
importances['importance_avg'] = importances[['importance_cls','importance_reg']].mean(axis=1)
importances.sort_values('importance_avg', ascending=False, inplace=True)
print(importances.head(10))

plt.figure(figsize=(10,6))
sns.barplot(data=importances.head(15), y='feature', x='importance_avg')
plt.title("Top 15 Important Features (Avg)")
plt.tight_layout()
plt.show()

print("\n📊 Error Analysis")
print(f"Accuracy: {accuracy_score(yc_test, yp_class):.3f}")
print(f"F1 Score: {f1_score(yc_test, yp_class):.3f}")
print(f"ROC AUC: {roc_auc_score(yc_test, yp_proba):.3f}")
print(f"R² (regression): {r2_score(yr_test, yp_reg):.3f}")
print(f"RMSE: {mean_squared_error(yr_test, yp_reg, squared=False):.3f}")

# Confusion Matrix
cm = confusion_matrix(yc_test, yp_class)
plt.figure(figsize=(6, 4))
sns.heatmap(cm, annot=True, fmt='d', cmap='Blues')
plt.title('Confusion Matrix - Classification')
plt.xlabel('Predicted')
plt.ylabel('Actual')
plt.show()

# ROC Curve
fpr, tpr, _ = roc_curve(yc_test, yp_proba)
plt.figure(figsize=(6, 4))
plt.plot(fpr, tpr, label=f'AUC = {roc_auc_score(yc_test, yp_proba):.3f}')
plt.plot([0,1],[0,1],'k--')
plt.xlabel('False Positive Rate')
plt.ylabel('True Positive Rate')
plt.title('ROC Curve')
plt.legend()
plt.grid(True)
plt.show()

# Directional Accuracy
actual_dir = (yr_test > 0).astype(int)
pred_dir = (yp_reg > 0).astype(int)
dir_acc = accuracy_score(actual_dir, pred_dir)
print(f"Directional Accuracy (Regression): {dir_acc:.3f}")
